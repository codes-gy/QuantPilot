APP_ENV=local
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://quantpilot:quantpilot@postgres:5432/quantpilot
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# paper(모의투자) | live(실전투자) — 기본값은 반드시 paper로 유지할 것
TRADING_MODE=paper
KILL_SWITCH_DEFAULT=false

# 오늘 실현손익이 이 금액(원)만큼 손실을 넘으면 kill switch 자동 발동. 비워두면 비활성화.
DAILY_LOSS_LIMIT_KRW=

# KIS Developers — 모의투자 (paper). 계좌 개설 + 모의투자 신청 후 발급.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_PAPER_WS_URL=ws://ops.koreainvestment.com:31000

# KIS Developers — 실전투자 (live). TRADING_MODE=live로 바꾸기 전까지는 비워둬도 됨.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_LIVE_WS_URL=ws://ops.koreainvestment.com:21000

# Upbit — 모의투자 서버가 없어 TRADING_MODE=paper일 때는 호출되지 않음.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
